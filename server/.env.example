# --- Required ---
MONGO_URI=mongodb://127.0.0.1:27017/ai-task-manager
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars

# --- Optional ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (only needed if client is served from another origin)
CLIENT_ORIGIN=http://localhost:5173

# --- AI (optional: without a key the app uses a built-in rule-based fallback) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
